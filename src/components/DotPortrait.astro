---
// The about-page portrait, drawn on the dot grid.
//
// The photo is pre-processed by scripts/portrait.py into a tiny 128x128
// "portrait map" (public/portrait/sam.png): grey = brightness, alpha = the
// person. This component samples that map once per dot and draws:
//
//   dots   halftone on the 12px half grid (every other dot is a page dot)
//   big    halftone on the full 24px grid
//   ascii  characters on the 12px grid, Martian Mono
//
// Light theme: ink dots, bigger where the photo is darker.
// Dark theme: paper dots, bigger where the photo is lighter.
// The cursor (or a tap) lights the dots near it orange: the first piece
// of the site-wide "lit dots" idea.
interface Props {
  src?: string;
  alt?: string;
}
const { src = '/portrait/sam.png', alt = 'Portrait of Sam, drawn in dots' } = Astro.props;
---

<figure class="portrait" data-portrait data-src={src}>
  <div class="portrait__stage">
    <canvas role="img" aria-label={alt}></canvas>
  </div>
  <div class="portrait__modes" role="group" aria-label="Portrait style">
    <button type="button" class="label" data-mode="dots" aria-pressed="true">dots</button>
    <button type="button" class="label" data-mode="big" aria-pressed="false">big</button>
    <button type="button" class="label" data-mode="ascii" aria-pressed="false">ascii</button>
  </div>
</figure>

<script>
  type Mode = 'dots' | 'big' | 'ascii';
  const PITCH: Record<Mode, number> = { dots: 12, big: 24, ascii: 12 };
  const RAMP = ' .:-=+*#%@'; // light to dark
  const LIT_RADIUS = 96; // px around the pointer that light up
  const ORANGE = [255, 102, 1];

  let cleanup: (() => void) | null = null;

  async function loadMap(src: string) {
    const img = new Image();
    img.src = src;
    await img.decode();
    const c = document.createElement('canvas');
    c.width = img.naturalWidth;
    c.height = img.naturalHeight;
    const ctx = c.getContext('2d', { willReadFrequently: true })!;
    ctx.drawImage(img, 0, 0);
    const { data, width, height } = ctx.getImageData(0, 0, c.width, c.height);
    // data is RGBA; the PNG is grey+alpha so R = G = B = brightness.
    return { data, width, height };
  }

  function init() {
    cleanup?.();
    cleanup = null;
    const root = document.querySelector<HTMLElement>('[data-portrait]');
    if (!root) return;
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const ac = new AbortController();
    const { signal } = ac;

    let map: Awaited<ReturnType<typeof loadMap>> | null = null;
    let mode: Mode = 'dots';
    let pointer: { x: number; y: number } | null = null;
    let w = 0, h = 0, dpr = 1;
    let raf = 0;

    // Bilinear sample of the map at u,v (0..1). Returns [brightness, alpha], 0..1.
    function sample(u: number, v: number): [number, number] {
      const m = map!;
      const x = Math.min(Math.max(u * m.width - 0.5, 0), m.width - 1);
      const y = Math.min(Math.max(v * m.height - 0.5, 0), m.height - 1);
      const x0 = Math.floor(x), y0 = Math.floor(y);
      const x1 = Math.min(x0 + 1, m.width - 1), y1 = Math.min(y0 + 1, m.height - 1);
      const fx = x - x0, fy = y - y0;
      const at = (xx: number, yy: number, ch: number) => m.data[(yy * m.width + xx) * 4 + ch] / 255;
      const lerp = (ch: number) =>
        at(x0, y0, ch) * (1 - fx) * (1 - fy) + at(x1, y0, ch) * fx * (1 - fy) +
        at(x0, y1, ch) * (1 - fx) * fy + at(x1, y1, ch) * fx * fy;
      return [lerp(0), lerp(3)];
    }

    // Theme: read the --color-fg token, so it follows the toggle and the
    // system setting without knowing how the theme is chosen. (Not the
    // element's `color`: body fades that over 0.2s, so it lags behind.)
    function fgColour() {
      const raw = getComputedStyle(root!).getPropertyValue('--color-fg').trim();
      let r = 13, g = 13, b = 15;
      const hex = raw.match(/^#([0-9a-f]{6})$/i);
      if (hex) {
        const n = parseInt(hex[1], 16);
        r = n >> 16; g = (n >> 8) & 255; b = n & 255;
      } else {
        const nums = raw.match(/\d+(\.\d+)?/g);
        if (nums && nums.length >= 3) [r, g, b] = nums.map(Number);
      }
      const dark = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 > 0.5; // light text = dark theme
      return { rgb: [r, g, b], dark };
    }

    function resize() {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      draw();
    }

    function draw() {
      if (!map || !w) return;
      const pitch = PITCH[mode];
      const { rgb, dark } = fgColour();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      // Put dot centres on PAGE multiples of the pitch, so the portrait
      // lines up with the background dots wherever the canvas sits.
      const r = canvas.getBoundingClientRect();
      const left = r.left + scrollX, top = r.top + scrollY;
      const x0 = Math.ceil(left / pitch) * pitch - left;
      const y0 = Math.ceil(top / pitch) * pitch - top;

      if (mode === 'ascii') {
        ctx.font = `500 ${pitch * 0.95}px 'Martian Mono', monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
      }

      for (let y = y0; y < h; y += pitch) {
        for (let x = x0; x < w; x += pitch) {
          const [l, a] = sample(x / w, y / h);
          if (a < 0.5) continue; // background: let the page dots show through
          const t = dark ? l : 1 - l; // how much "ink" this dot gets

          // Lit spot: 1 at the pointer, 0 at LIT_RADIUS, smooth in between.
          let k = 0;
          if (pointer) {
            const d = Math.hypot(x - pointer.x, y - pointer.y) / LIT_RADIUS;
            k = d < 1 ? 1 - d * d * (3 - 2 * d) : 0;
          }
          const c = rgb.map((v, i) => Math.round(v + (ORANGE[i] - v) * k));
          ctx.fillStyle = `rgb(${c[0]},${c[1]},${c[2]})`;

          if (mode === 'ascii') {
            const ch = RAMP[Math.min(RAMP.length - 1, Math.floor(t * RAMP.length))];
            if (ch !== ' ') ctx.fillText(ch, x, y);
          } else {
            const radius = Math.max(1.2, t * pitch * 0.5) * (1 + 0.3 * k);
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
    }

    // Redraw at most once per frame, however fast the pointer moves.
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; draw(); });
    };

    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer = { x: e.clientX - r.left, y: e.clientY - r.top };
      schedule();
    }, { signal });
    canvas.addEventListener('pointerdown', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer = { x: e.clientX - r.left, y: e.clientY - r.top };
      schedule();
    }, { signal });
    canvas.addEventListener('pointerleave', () => { pointer = null; schedule(); }, { signal });

    buttons.forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode as Mode;
      buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      draw();
    }, { signal }));

    // Theme changes: redraw when the html attributes or the OS scheme change.
    const mo = new MutationObserver(() => draw());
    mo.observe(document.documentElement, { attributes: true });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', draw, { signal });

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    loadMap(root.dataset.src!).then((m) => { map = m; resize(); });
    document.fonts?.ready.then(draw);

    cleanup = () => {
      ac.abort();
      mo.disconnect();
      ro.disconnect();
      cancelAnimationFrame(raf);
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>

<style>
  .portrait {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--grid);
  }
  .portrait__stage {
    aspect-ratio: 1;
    width: 100%;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }

  .portrait__modes {
    align-self: flex-start;
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid color-mix(in oklab, var(--color-fg) 14%, transparent);
    border-radius: 999px;
    background: var(--color-bg);
  }
  .portrait__modes button {
    min-height: 40px;
    padding: 0 calc(var(--grid) * 2 / 3);
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    opacity: 0.6;
    cursor: pointer;
  }
  .portrait__modes button[aria-pressed='true'] {
    background: var(--color-fg);
    color: var(--color-bg);
    opacity: 1;
  }
</style>
