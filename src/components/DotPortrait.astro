---
// Sam's portrait, drawn on the dot grid.
//
// The photo is pre-processed by scripts/portrait.py into a tiny 128x128
// "portrait map" (public/portrait/sam.png): grey = brightness, alpha = the
// person. This component samples it once per dot and draws:
//
//   dots   halftone on the 12px half grid (every other dot is a page dot)
//   big    halftone on the full 24px grid
//   ascii  characters on the 12px grid, Martian Mono
//
// Light theme: ink dots, bigger where the photo is darker.
// Dark theme: paper dots, bigger where the photo is lighter.
//
// Hover / touch: the dots near the pointer get pushed away and light up in
// the page colour, then spring back when it leaves.
//
// Props:
//   href      make the portrait a link (home: to /about)
//   controls  show the dots / big / ascii toggle (default true)
//   split     the portrait sits across the bottom edge of the page's flood:
//             dots over the flood draw in ink, dots below in the page colours
interface Props {
  src?: string;
  alt?: string;
  href?: string;
  controls?: boolean;
  split?: boolean;
}
const {
  src = '/portrait/sam.png',
  alt = 'Portrait of Sam, drawn in dots',
  href,
  controls = true,
  split = false,
} = Astro.props;
const Stage = href ? 'a' : 'div';
---

<figure class="portrait" data-portrait data-src={src} data-split={split ? '' : undefined}>
  <Stage class="portrait__stage" href={href} aria-label={href ? 'About Sam' : undefined}>
    <canvas role="img" aria-label={alt}></canvas>
  </Stage>
  {href && <span class="portrait__hint label" aria-hidden="true">about</span>}
  {controls && (
    <div class="portrait__modes" role="group" aria-label="Portrait style">
      <button type="button" class="label" data-mode="dots" aria-pressed="true">dots</button>
      <button type="button" class="label" data-mode="big" aria-pressed="false">big</button>
      <button type="button" class="label" data-mode="ascii" aria-pressed="false">ascii</button>
    </div>
  )}
</figure>

<script>
  import { reducedMotion } from '../lib/motion';

  type Mode = 'dots' | 'big' | 'ascii';
  type PortraitMap = { data: Uint8ClampedArray; width: number; height: number };
  const PITCH: Record<Mode, number> = { dots: 12, big: 24, ascii: 12 };
  const RAMP = ' .:-=+*#%@'; // light to dark
  const REACH = 260; // px around the pointer that react
  const PUSH = 56; // px: how far dots get shoved at the pointer itself
  const SWIRL = 0.4; // sideways twist, as a share of the push
  const BIG = 720; // px: above this width, 'dots' mode uses the 24px grid
  const GLYPH_AT = 0.3; // dots this close to the pointer (0..1) turn into glyphs
  const GLYPHS = ['bar', 'chevron', 'plus', 'square'];

  // Each dot gets its own glyph, picked at random but fixed (a hash of its
  // grid position), so they don't flicker as the pointer moves.
  function glyphFor(ix: number, iy: number) {
    let h = Math.imul(ix, 73856093) ^ Math.imul(iy, 19349663);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return GLYPHS[(h >>> 0) % GLYPHS.length];
  }

  // The brand glyphs (same geometry as Glyph.astro, in a 24px cell),
  // centred on x, y and scaled by s.
  function drawGlyph(c: CanvasRenderingContext2D, kind: string, x: number, y: number, s: number) {
    c.save();
    c.translate(x, y);
    c.scale(s, s);
    c.translate(-12, -12);
    c.beginPath();
    if (kind === 'bar') { c.rect(11.1, 8.5, 1.8, 7); c.fill(); }
    else if (kind === 'square') { c.rect(9.9, 9.9, 4.2, 4.2); c.fill(); }
    else {
      c.lineWidth = 1.6;
      c.strokeStyle = c.fillStyle;
      if (kind === 'chevron') { c.moveTo(10.5, 9); c.lineTo(13.5, 12); c.lineTo(10.5, 15); }
      else { c.moveTo(9, 12); c.lineTo(15, 12); c.moveTo(12, 9); c.lineTo(12, 15); }
      c.stroke();
    }
    c.restore();
  }

  // Load each portrait map once, however many portraits use it.
  const maps = new Map<string, Promise<PortraitMap>>();
  function loadMap(src: string): Promise<PortraitMap> {
    if (!maps.has(src)) {
      maps.set(src, (async () => {
        const img = new Image();
        img.src = src;
        await img.decode();
        const c = document.createElement('canvas');
        c.width = img.naturalWidth;
        c.height = img.naturalHeight;
        const ctx = c.getContext('2d', { willReadFrequently: true })!;
        ctx.drawImage(img, 0, 0);
        const { data, width, height } = ctx.getImageData(0, 0, c.width, c.height);
        return { data, width, height }; // grey+alpha PNG: R = G = B = brightness
      })());
    }
    return maps.get(src)!;
  }

  // '#rrggbb' or 'rgb(r, g, b)' -> [r, g, b]
  function rgb(css: string): number[] {
    const hex = css.trim().match(/^#([0-9a-f]{6})$/i);
    if (hex) { const n = parseInt(hex[1], 16); return [n >> 16, (n >> 8) & 255, n & 255]; }
    const nums = css.match(/\d+(\.\d+)?/g);
    return nums && nums.length >= 3 ? nums.slice(0, 3).map(Number) : [13, 13, 15];
  }
  const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));

  function mount(root: HTMLElement): () => void {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const split = root.hasAttribute('data-split');
    const ac = new AbortController();
    const { signal } = ac;

    let map: PortraitMap | null = null;
    let mode: Mode = 'dots';
    let w = 0, h = 0, dpr = 1;
    let raf = 0;
    // The pointer, eased, and how strongly it's acting (0..1).
    const p = { x: 0, y: 0, tx: 0, ty: 0, level: 0, target: 0 };

    function sample(u: number, v: number): [number, number] {
      const m = map!;
      const x = Math.min(Math.max(u * m.width - 0.5, 0), m.width - 1);
      const y = Math.min(Math.max(v * m.height - 0.5, 0), m.height - 1);
      const x0 = Math.floor(x), y0 = Math.floor(y);
      const x1 = Math.min(x0 + 1, m.width - 1), y1 = Math.min(y0 + 1, m.height - 1);
      const fx = x - x0, fy = y - y0;
      const at = (xx: number, yy: number, ch: number) => m.data[(yy * m.width + xx) * 4 + ch] / 255;
      const lerp = (ch: number) =>
        at(x0, y0, ch) * (1 - fx) * (1 - fy) + at(x1, y0, ch) * fx * (1 - fy) +
        at(x0, y1, ch) * (1 - fx) * fy + at(x1, y1, ch) * fx * fy;
      return [lerp(0), lerp(3)];
    }

    function resize() {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      draw();
    }

    function draw() {
      if (!map || !w) return;
      // Big portraits stay coarse: same dot count, bigger dots, not more detail.
      const pitch = mode === 'dots' && w > BIG ? 24 : PITCH[mode];
      // Colours from the tokens (not `color`, which fades with the theme).
      const cs = getComputedStyle(root);
      const fg = rgb(cs.getPropertyValue('--color-fg'));
      const accent = rgb(cs.getPropertyValue('--page-accent'));
      const ink = rgb(cs.getPropertyValue('--flood-fg') || '#0d0d0f');
      const dark = (0.2126 * fg[0] + 0.7152 * fg[1] + 0.0722 * fg[2]) / 255 > 0.5;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      const r = canvas.getBoundingClientRect();
      // Where the flood ends, in canvas pixels (split mode only).
      let edge = -Infinity;
      if (split) {
        const flood = document.querySelector('.flood');
        if (flood) edge = flood.getBoundingClientRect().bottom - r.top;
      }
      // Dot centres on PAGE multiples of the pitch, so they line up with
      // the background dots wherever the canvas sits.
      const left = r.left + scrollX, top = r.top + scrollY;
      const x0 = Math.ceil(left / pitch) * pitch - left;
      const y0 = Math.ceil(top / pitch) * pitch - top;

      if (mode === 'ascii') {
        ctx.font = `500 ${pitch * 0.95}px 'Martian Mono', monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
      }

      for (let y = y0; y < h; y += pitch) {
        const onFlood = y < edge;
        // On the flood: ink, positive (dark = big). Below: theme colours.
        const base = onFlood ? ink : fg;
        const lit = onFlood ? fg : accent;
        const flip = onFlood ? false : dark;
        for (let x = x0; x < w; x += pitch) {
          const [l, a] = sample(x / w, y / h);
          if (a < 0.5) continue; // background: let the page show through
          const t = flip ? l : 1 - l; // how much "ink" this dot gets

          // Near the pointer: push away and light up.
          let dx = 0, dy = 0, k = 0;
          if (p.level > 0.01) {
            const ex = x - p.x, ey = y - p.y;
            const d = Math.hypot(ex, ey);
            if (d < REACH) {
              const f = 1 - d / REACH;
              k = f * f * (3 - 2 * f) * p.level;
              if (!reducedMotion() && d > 0.01) {
                // Away from the pointer, plus a twist around it.
                const push = f * f * PUSH * p.level;
                const nx = ex / d, ny = ey / d;
                dx = nx * push - ny * push * SWIRL;
                dy = ny * push + nx * push * SWIRL;
              }
            }
          }
          const c = mix(base, lit, k);
          ctx.fillStyle = `rgb(${c[0]},${c[1]},${c[2]})`;

          if (mode === 'ascii') {
            const ch = RAMP[Math.min(RAMP.length - 1, Math.floor(t * RAMP.length))];
            if (ch !== ' ') ctx.fillText(ch, x + dx, y + dy);
          } else if (k > GLYPH_AT) {
            // Close to the pointer: the dot becomes one of the brand glyphs,
            // sized from how much ink the dot had, growing with k.
            const kind = glyphFor(Math.round((left + x) / pitch), Math.round((top + y) / pitch));
            const s = (pitch / 24) * (1.6 + 2.4 * t) * (1 + 0.6 * k);
            drawGlyph(ctx, kind, x + dx, y + dy, s);
          } else {
            const radius = Math.max(1.4, t * pitch * 0.56) * (1 + 0.6 * k);
            ctx.beginPath();
            ctx.arc(x + dx, y + dy, radius, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
    }

    // Ease the pointer and its strength, redraw until settled.
    function step() {
      raf = 0;
      const e = reducedMotion() ? 1 : 0.25;
      p.x += (p.tx - p.x) * e;
      p.y += (p.ty - p.y) * e;
      p.level += (p.target - p.level) * (reducedMotion() ? 1 : 0.15);
      draw();
      if (Math.abs(p.tx - p.x) > 0.3 || Math.abs(p.ty - p.y) > 0.3 || Math.abs(p.target - p.level) > 0.01) {
        raf = requestAnimationFrame(step);
      }
    }
    const kick = () => { if (!raf) raf = requestAnimationFrame(step); };

    function point(e: PointerEvent) {
      const r = canvas.getBoundingClientRect();
      p.tx = e.clientX - r.left;
      p.ty = e.clientY - r.top;
      if (p.level < 0.05) { p.x = p.tx; p.y = p.ty; } // start under the pointer
      p.target = 1;
      kick();
    }
    canvas.addEventListener('pointermove', point, { signal });
    canvas.addEventListener('pointerdown', point, { signal });
    canvas.addEventListener('pointerleave', () => { p.target = 0; kick(); }, { signal });

    buttons.forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode as Mode;
      buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      draw();
    }, { signal }));

    // Redraw on theme change and on scroll (split mode tracks the flood edge).
    const mo = new MutationObserver(() => draw());
    mo.observe(document.documentElement, { attributes: true });
    if (split) addEventListener('scroll', () => kick(), { passive: true, signal });

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    loadMap(root.dataset.src!).then((m) => { map = m; resize(); });
    document.fonts?.ready.then(draw);

    return () => { ac.abort(); mo.disconnect(); ro.disconnect(); cancelAnimationFrame(raf); };
  }

  let cleanups: (() => void)[] = [];
  document.addEventListener('astro:page-load', () => {
    cleanups.forEach((c) => c());
    cleanups = [...document.querySelectorAll<HTMLElement>('[data-portrait]')].map(mount);
  });
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((c) => c());
    cleanups = [];
  });
</script>

<style>
  .portrait {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--grid);
  }
  .portrait__stage {
    display: block;
    aspect-ratio: 1;
    width: 100%;
    color: inherit;
  }
  a.portrait__stage {
    cursor: pointer;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }
  a.portrait__stage canvas {
    cursor: pointer;
  }

  .portrait__hint {
    align-self: flex-end;
    margin-top: calc(var(--grid) * -1);
    opacity: 0.5;
    transition: opacity var(--transition);
  }
  .portrait:hover .portrait__hint,
  .portrait:focus-within .portrait__hint {
    opacity: 1;
    color: var(--orange-text);
  }

  .portrait__modes {
    align-self: flex-start;
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid color-mix(in oklab, var(--color-fg) 14%, transparent);
    border-radius: 999px;
    background: var(--color-bg);
  }
  .portrait__modes button {
    min-height: 40px;
    padding: 0 calc(var(--grid) * 2 / 3);
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    opacity: 0.6;
    cursor: pointer;
  }
  .portrait__modes button[aria-pressed='true'] {
    background: var(--color-fg);
    color: var(--color-bg);
    opacity: 1;
  }
</style>
