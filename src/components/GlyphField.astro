---
// A field of repeated glyphs, locked to the page's 24px grid.
// Used as the background of floods and of project cards without an image.
//
// The parent decides size and stacking: give it `position: relative` and
// `isolation: isolate`, and this sits behind its content (z-index -1).
import Glyph from './Glyph.astro';
import type { GlyphKind } from '../lib/categories';

interface Props {
  kind: GlyphKind;
  /** Any CSS colour, including var(--cat-sound) or var(--flood-fg). */
  color?: string;
  /** Number or CSS value, e.g. 0.4 or 'var(--flood-mark-opacity)'. */
  opacity?: number | string;
}

const { kind, color = 'currentColor', opacity = 1 } = Astro.props;

// SVG pattern ids are global to the whole page, so each field gets its own.
const id = `glyph-field-${kind}-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="glyph-field" aria-hidden="true" style={`color: ${color}`}>
  <defs>
    {/* x/y = -12 puts glyph centres on the grid lines when the field starts
        at the page's top-left. The script corrects it everywhere else. */}
    <pattern id={id} x="-12" y="-12" width="24" height="24" patternUnits="userSpaceOnUse" data-grid-pattern>
      <g style={`opacity: ${opacity}`}>
        <Glyph kind={kind} variant="grid" size={24} />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<script>
  // An SVG pattern tiles from the SVG's own corner, so a field that starts
  // 830px down the page would be 830 % 24 = 14px out of step with the page
  // grid. Shift each pattern's origin by where its SVG sits on the page.
  const GRID = 24;

  function alignFields() {
    document.querySelectorAll<SVGPatternElement>('[data-grid-pattern]').forEach((pattern) => {
      const svg = pattern.ownerSVGElement;
      if (!svg) return;
      const r = svg.getBoundingClientRect();
      const left = r.left + window.scrollX;
      const top = r.top + window.scrollY;
      // + GRID / 2: glyphs are drawn centred in their tile; dots belong ON the lines.
      pattern.setAttribute('x', String(-((left + GRID / 2) % GRID)));
      pattern.setAttribute('y', String(-((top + GRID / 2) % GRID)));
    });
  }

  let observer: ResizeObserver | null = null;
  document.addEventListener('astro:page-load', () => {
    alignFields();
    document.fonts?.ready.then(alignFields); // web fonts can shift layout
    // Anything that changes the page's height can move fields further down.
    observer?.disconnect();
    observer = new ResizeObserver(alignFields);
    observer.observe(document.body);
  });
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>

<style>
  .glyph-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    display: block;
    pointer-events: none;
  }
</style>
