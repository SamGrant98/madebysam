---
// The "lit" layer: marks on the page grid light up near a light source,
// like an LED matrix behind the paper.
//
// Two places get lit:
//   paper   one fixed canvas behind <main>: dots light up in the page
//           colour (--page-accent: orange, or the project's category)
//   floods  each FloodHero has its own canvas (data-lit-glyph): its glyphs
//           light up in the text colour, black in light mode, white in dark
// Everything sits on page multiples of 24px, exactly over the resting marks.
//
// The light follows:
//   cursor  on mouse / trackpad
//   finger  on touch: lights where you touch, fades out after you let go
//   tilt    on phones: Android straight away; iOS asks permission on the
//           first tap on empty page space (Safari only allows that request
//           from a tap)
// Reduced motion: the light snaps to the pointer, no easing, no tilt.
---

<canvas class="lit" aria-hidden="true" transition:persist="lit-dots"></canvas>

<style>
  .lit {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0; /* above the body dots, below <main> (z-index 1) */
    pointer-events: none;
  }
</style>

<script>
  import { reducedMotion } from '../lib/motion';

  const GRID = 24;
  const RADIUS = 144; // px: how far the light reaches (6 cells)
  const EASE = 0.18; // how quickly the light catches up with its target

  type Flood = { canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D; kind: string };

  // The glyphs, drawn in their 24x24 cell, centred on (x, y), scaled by s.
  // Same geometry as Glyph.astro.
  function glyph(c: CanvasRenderingContext2D, kind: string, x: number, y: number, s: number) {
    c.save();
    c.translate(x, y);
    c.scale(s, s);
    c.translate(-12, -12);
    c.lineWidth = 1.6;
    c.beginPath();
    if (kind === 'bar') c.rect(11.1, 8.5, 1.8, 7);
    else if (kind === 'square') c.rect(9.9, 9.9, 4.2, 4.2);
    else if (kind === 'chevron') { c.moveTo(10.5, 9); c.lineTo(13.5, 12); c.lineTo(10.5, 15); }
    else if (kind === 'plus') { c.moveTo(9, 12); c.lineTo(15, 12); c.moveTo(12, 9); c.lineTo(12, 15); }
    else c.arc(12, 12, 1.5, 0, Math.PI * 2);
    if (kind === 'chevron' || kind === 'plus') c.stroke();
    else c.fill();
    c.restore();
  }

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.lit');
  if (canvas && !canvas.dataset.ready) {
    canvas.dataset.ready = '1';
    const ctx = canvas.getContext('2d')!;
    const reduce = reducedMotion();

    let w = 0, h = 0, dpr = 1;
    const light = { x: -999, y: -999 };
    const target = { x: -999, y: -999 };
    let level = 0, targetLevel = 0;
    let raf = 0;
    let fadeTimer = 0;
    let tilting = false;

    // Per-page state, refreshed on every navigation and theme change.
    let accent = '#ff6601';
    let fg = '#0d0d0f';
    let floods: Flood[] = [];
    function refresh() {
      const cs = getComputedStyle(document.documentElement);
      accent = cs.getPropertyValue('--page-accent').trim() || accent;
      fg = cs.getPropertyValue('--color-fg').trim() || fg;
      floods = [...document.querySelectorAll<HTMLCanvasElement>('canvas[data-lit-glyph]')].map((c) => ({
        canvas: c,
        ctx: c.getContext('2d')!,
        kind: c.dataset.litGlyph || 'dot',
      }));
      kick();
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = innerWidth;
      h = innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      kick();
    }

    // Visit every grid point within the light's reach. Points are at PAGE
    // multiples of GRID, so on screen they're offset by the scroll.
    function eachLitPoint(fn: (x: number, y: number, k: number) => void) {
      const sx = scrollX, sy = scrollY;
      const x0 = Math.ceil((light.x + sx - RADIUS) / GRID) * GRID - sx;
      const y0 = Math.ceil((light.y + sy - RADIUS) / GRID) * GRID - sy;
      for (let y = y0; y <= light.y + RADIUS; y += GRID) {
        for (let x = x0; x <= light.x + RADIUS; x += GRID) {
          const d = Math.hypot(x - light.x, y - light.y) / RADIUS;
          if (d < 1) fn(x, y, (1 - d * d * (3 - 2 * d)) * level); // smoothstep falloff
        }
      }
    }

    function drawPaper() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      if (level < 0.01) return;
      ctx.fillStyle = accent;
      eachLitPoint((x, y, k) => {
        ctx.globalAlpha = k;
        ctx.beginPath();
        ctx.arc(x, y, 1.5 + 2 * k, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;
    }

    function drawFloods() {
      for (const f of floods) {
        if (!f.canvas.isConnected) continue;
        const r = f.canvas.getBoundingClientRect();
        const cw = Math.round(r.width * dpr), ch = Math.round(r.height * dpr);
        if (f.canvas.width !== cw || f.canvas.height !== ch) { f.canvas.width = cw; f.canvas.height = ch; }
        const c = f.ctx;
        c.setTransform(dpr, 0, 0, dpr, 0, 0);
        c.clearRect(0, 0, r.width, r.height);
        // Skip floods the light can't reach (most of the time, all of them).
        if (level < 0.01 || light.x < r.left - RADIUS || light.x > r.right + RADIUS ||
            light.y < r.top - RADIUS || light.y > r.bottom + RADIUS) continue;
        c.fillStyle = fg;
        c.strokeStyle = fg;
        const grow = f.kind === 'dot' ? 1.2 : 0.5;
        eachLitPoint((x, y, k) => {
          c.globalAlpha = k;
          glyph(c, f.kind, x - r.left, y - r.top, 1 + grow * k);
        });
        c.globalAlpha = 1;
      }
    }

    // Animate until the light has caught up, then stop (no idle loop).
    function step() {
      raf = 0;
      const t = reduce ? 1 : EASE;
      light.x += (target.x - light.x) * t;
      light.y += (target.y - light.y) * t;
      level += (targetLevel - level) * (reduce ? 1 : 0.12);
      drawPaper();
      drawFloods();
      const moving =
        Math.abs(target.x - light.x) > 0.5 ||
        Math.abs(target.y - light.y) > 0.5 ||
        Math.abs(targetLevel - level) > 0.01;
      if (moving) raf = requestAnimationFrame(step);
    }
    function kick() {
      if (!raf) raf = requestAnimationFrame(step);
    }

    function aim(x: number, y: number, snap = false) {
      target.x = x;
      target.y = y;
      if (snap || level < 0.05) { light.x = x; light.y = y; } // don't sweep in from offscreen
      targetLevel = 1;
      kick();
    }

    // ---- Cursor and touch ----
    addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || e.pointerType === 'pen' || e.buttons) aim(e.clientX, e.clientY);
    }, { passive: true });
    addEventListener('pointerdown', (e) => {
      clearTimeout(fadeTimer);
      aim(e.clientX, e.clientY, e.pointerType === 'touch');
    }, { passive: true });
    addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'touch' || tilting) return;
      fadeTimer = window.setTimeout(() => { targetLevel = 0; kick(); }, 600);
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => {
      if (!tilting) { targetLevel = 0; kick(); }
    });
    addEventListener('scroll', () => { if (level > 0.01) kick(); }, { passive: true });
    addEventListener('resize', resize);

    // New page, or theme switched: pick up the new colours and floods.
    document.addEventListener('astro:page-load', refresh);
    new MutationObserver(refresh).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'data-accent'],
    });

    // ---- Tilt (phones) ----
    // beta: front/back tilt (about 45deg when holding a phone), gamma: left/right.
    function onTilt(e: DeviceOrientationEvent) {
      if (e.beta == null || e.gamma == null) return;
      tilting = true;
      const fx = Math.max(-1, Math.min(1, e.gamma / 30));
      const fy = Math.max(-1, Math.min(1, (e.beta - 45) / 30));
      aim(w / 2 + fx * w * 0.45, h / 2 + fy * h * 0.45);
    }
    type IOSOrientation = typeof DeviceOrientationEvent & { requestPermission?: () => Promise<string> };
    const DOE = (window as any).DeviceOrientationEvent as IOSOrientation | undefined;
    const touchDevice = matchMedia('(hover: none)').matches;
    if (DOE && touchDevice && !reduce) {
      if (typeof DOE.requestPermission === 'function') {
        // iOS: ask once, on the first tap that isn't on a link or control.
        const ask = (e: PointerEvent) => {
          if ((e.target as Element).closest('a, button, input, select, textarea, canvas')) return;
          removeEventListener('pointerup', ask);
          DOE.requestPermission!().then((r) => {
            if (r === 'granted') addEventListener('deviceorientation', onTilt);
          }).catch(() => {});
        };
        addEventListener('pointerup', ask);
      } else {
        addEventListener('deviceorientation', onTilt);
      }
    }

    resize();
    refresh();
  }
</script>
