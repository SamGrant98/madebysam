---
// The "lit" layer: dots on the page grid light up orange near a light
// source, like an LED matrix behind the paper.
//
// One fixed canvas behind <main>. It only draws the lit dots (the resting
// dots are the body background), at page multiples of 24px, so they sit
// exactly on top of the background dots. Anything with its own background
// (floods, cards, images) covers it, so the light lives in the paper.
//
// The light follows:
//   cursor  on mouse / trackpad
//   finger  on touch: lights where you touch, fades out after you let go
//   tilt    on phones: Android straight away; iOS asks permission on the
//           first tap on empty page space (Safari only allows that request
//           from a tap)
// Reduced motion: the light snaps to the pointer, no easing, no tilt.
---

<canvas class="lit" aria-hidden="true" transition:persist="lit-dots"></canvas>

<style>
  .lit {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0; /* above the body dots, below <main> (z-index 1) */
    pointer-events: none;
  }
</style>

<script>
  const GRID = 24;
  const RADIUS = 144; // px: how far the light reaches (6 cells)
  const EASE = 0.18; // how quickly the light catches up with its target
  const ORANGE = '255, 102, 1';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.lit');
  if (canvas && !canvas.dataset.ready) {
    canvas.dataset.ready = '1';
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let w = 0, h = 0, dpr = 1;
    // Where the light is, where it's heading, and how bright it is (0..1).
    const light = { x: -999, y: -999 };
    const target = { x: -999, y: -999 };
    let level = 0, targetLevel = 0;
    let raf = 0;
    let fadeTimer = 0;
    let tilting = false;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = innerWidth;
      h = innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      kick();
    }

    function draw() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      if (level < 0.01) return;

      // Only the dots inside the light's reach. Dot centres are at page
      // multiples of GRID, so on screen they're offset by the scroll.
      const sy = scrollY;
      const x0 = Math.ceil((light.x - RADIUS) / GRID) * GRID;
      const y0 = Math.ceil((light.y + sy - RADIUS) / GRID) * GRID - sy;
      for (let y = y0; y <= light.y + RADIUS; y += GRID) {
        for (let x = x0; x <= light.x + RADIUS; x += GRID) {
          const d = Math.hypot(x - light.x, y - light.y) / RADIUS;
          if (d >= 1) continue;
          const k = (1 - d * d * (3 - 2 * d)) * level; // smoothstep falloff
          ctx.fillStyle = `rgba(${ORANGE}, ${k})`;
          ctx.beginPath();
          ctx.arc(x, y, 1.5 + 2 * k, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    // Animate until the light has caught up, then stop (no idle loop).
    function step() {
      raf = 0;
      const t = reduce ? 1 : EASE;
      light.x += (target.x - light.x) * t;
      light.y += (target.y - light.y) * t;
      level += (targetLevel - level) * (reduce ? 1 : 0.12);
      draw();
      const moving =
        Math.abs(target.x - light.x) > 0.5 ||
        Math.abs(target.y - light.y) > 0.5 ||
        Math.abs(targetLevel - level) > 0.01;
      if (moving) raf = requestAnimationFrame(step);
    }
    function kick() {
      if (!raf) raf = requestAnimationFrame(step);
    }

    function aim(x: number, y: number, snap = false) {
      target.x = x;
      target.y = y;
      if (snap || level < 0.05) { light.x = x; light.y = y; } // don't sweep in from offscreen
      targetLevel = 1;
      kick();
    }

    // ---- Cursor and touch ----
    addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || e.pointerType === 'pen' || e.buttons) aim(e.clientX, e.clientY);
    }, { passive: true });
    addEventListener('pointerdown', (e) => {
      clearTimeout(fadeTimer);
      aim(e.clientX, e.clientY, e.pointerType === 'touch');
    }, { passive: true });
    addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'touch' || tilting) return;
      fadeTimer = window.setTimeout(() => { targetLevel = 0; kick(); }, 600);
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => {
      if (!tilting) { targetLevel = 0; kick(); }
    });
    addEventListener('scroll', () => { if (level > 0.01) kick(); }, { passive: true });
    addEventListener('resize', resize);

    // ---- Tilt (phones) ----
    // beta: front/back tilt (about 45deg when holding a phone), gamma: left/right.
    function onTilt(e: DeviceOrientationEvent) {
      if (e.beta == null || e.gamma == null) return;
      tilting = true;
      const fx = Math.max(-1, Math.min(1, e.gamma / 30));
      const fy = Math.max(-1, Math.min(1, (e.beta - 45) / 30));
      aim(w / 2 + fx * w * 0.45, h / 2 + fy * h * 0.45);
    }
    type IOSOrientation = typeof DeviceOrientationEvent & { requestPermission?: () => Promise<string> };
    const DOE = (window as any).DeviceOrientationEvent as IOSOrientation | undefined;
    const touchDevice = matchMedia('(hover: none)').matches;
    if (DOE && touchDevice && !reduce) {
      if (typeof DOE.requestPermission === 'function') {
        // iOS: ask once, on the first tap that isn't on a link or control.
        const ask = (e: PointerEvent) => {
          if ((e.target as Element).closest('a, button, input, select, textarea, canvas')) return;
          removeEventListener('pointerup', ask);
          DOE.requestPermission!().then((r) => {
            if (r === 'granted') addEventListener('deviceorientation', onTilt);
          }).catch(() => {});
        };
        addEventListener('pointerup', ask);
      } else {
        addEventListener('deviceorientation', onTilt);
      }
    }

    resize();
  }
</script>
