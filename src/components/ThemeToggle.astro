---
// Toggles between light/dark by flipping the data-theme attribute on <html>.
// The no-flash init script lives in Base.astro so theme is set before paint.
---

<button id="theme-toggle" type="button" aria-label="Toggle color theme">
  <svg class="icon sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    transition: background var(--transition);
  }
  button:hover {
    background: color-mix(in oklab, currentColor 15%, transparent);
  }
  .icon {
    width: 1.1rem;
    height: 1.1rem;
  }
  :root[data-theme='light'] .moon {
    display: none;
  }
  :root[data-theme='dark'] .sun {
    display: none;
  }
</style>

<script>
  // Bind on every page-load so the handler re-attaches after ClientRouter
  // swaps. Without this, the button on subsequent pages had no click
  // handler and the theme felt "stuck" — clicks did nothing.
  function bindThemeToggle() {
    const btn = document.getElementById('theme-toggle') as
      | (HTMLButtonElement & { dataset: { bound?: string } })
      | null;
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }
  document.addEventListener('astro:page-load', bindThemeToggle);
  bindThemeToggle();
</script>
