---
// Full-viewport WebGL topographic background.
// The heavy lifting lives in ../scripts/topo.ts — this file is just the canvas + mount.
---

<canvas id="topo-canvas" aria-hidden="true"></canvas>

<style>
  #topo-canvas {
    position: fixed;
    inset: 0;
    display: block;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  import { initTopoCanvas } from '../scripts/topo';
  const canvas = document.getElementById('topo-canvas') as HTMLCanvasElement | null;
  if (canvas) initTopoCanvas(canvas);
</script>
