---
// Full-viewport WebGL topographic background.
// The heavy lifting lives in ../scripts/topo.ts — this file is just the canvas + mount.
---

<canvas id="topo-canvas" aria-hidden="true" transition:persist="topo-canvas"></canvas>

<style>
  #topo-canvas {
    position: fixed;
    inset: 0;
    display: block;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  import { initTopoCanvas } from '../scripts/topo';

  // Guard against double-init: the ClientRouter may re-run hoisted scripts on
  // navigation, but we only want one renderer attached to the canvas.
  const INIT_KEY = '__topoInitialised';
  const canvas = document.getElementById('topo-canvas') as
    | (HTMLCanvasElement & { [INIT_KEY]?: boolean })
    | null;
  if (canvas && !canvas[INIT_KEY]) {
    canvas[INIT_KEY] = true;
    initTopoCanvas(canvas);
  }

  // The old topo-to-grid morph on /lab routes is gone: the lab and project
  // pages now sit on the CSS dot grid with no canvas. setMorph() still
  // exists in topo.ts if we want it back.
</script>
