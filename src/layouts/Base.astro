---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import TopoCanvas from '../components/TopoCanvas.astro';
import '../styles/global.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  showTopo?: boolean;
  // Breadcrumb path that trails after the brand mark, e.g.
  //   /lab          → [{ label: 'lab' }]
  //   /lab/dvd-shelf → [{ label: 'lab', href: '/lab' }, { label: 'DVD Shelf' }]
  // The brand "made by sam" is implicitly the root crumb and always links to /.
  breadcrumb?: Crumb[];
  // Path or URL to a page-specific OG image. Relative paths (e.g. '/og/foo.png'
  // or the .src of an Astro-processed image) are resolved against `site` in
  // astro.config so social crawlers get an absolute URL. Falls back to the
  // site-wide default at /og-default.png.
  ogImage?: string;
}

const {
  title = 'made by sam',
  description = 'Personal site & creative web experiments by Sam Grant.',
  showTopo = true,
  breadcrumb = [],
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const resolvedOgImage = new URL(ogImage ?? '/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Open Graph — what Slack, Discord, LinkedIn, Facebook, iMessage etc. read */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="made by sam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter card — Twitter has its own taxonomy but accepts og:* as fallback */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {/* No-flash theme script — runs before paint on initial load AND on every
        ClientRouter navigation (astro:before-swap fires before the new document
        is shown, so we can stamp data-theme onto it without a flash). */}
    <script is:inline>
      (function () {
        function pickTheme() {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          return stored || (prefersDark ? 'dark' : 'light');
        }
        document.documentElement.setAttribute('data-theme', pickTheme());
        document.addEventListener('astro:before-swap', function (e) {
          e.newDocument.documentElement.setAttribute('data-theme', pickTheme());
        });
      })();
    </script>

    {/* Client-side routing so the topo canvas, WebGL state, and mouse position persist between pages */}
    <ClientRouter />

    {/* Outbound fade for cross-origin links (sibling subdomains).
        Re-runs on every Astro page-load so re-rendered cards keep working. */}
    <script>
      function bindCrossOriginFade() {
        document
          .querySelectorAll('a[href*="madebysam.dev"]:not([data-fade-bound])')
          .forEach((a) => {
            const href = a.getAttribute('href') || '';
            // Only intercept actual cross-origin links (anything that
            // doesn't start with "/" and isn't pointing at our own origin)
            if (!/^https?:\/\//.test(href)) return;
            try {
              const url = new URL(href);
              if (url.origin === window.location.origin) return;
            } catch { return; }

            a.setAttribute('data-fade-bound', '1');
            a.addEventListener('click', (e) => {
              if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
              if (a.target === '_blank') return;
              e.preventDefault();
              document.body.classList.add('is-leaving');
              setTimeout(() => { window.location.href = a.href; }, 300);
            });
          });
      }
      document.addEventListener('astro:page-load', bindCrossOriginFade);
      bindCrossOriginFade();
    </script>
  </head>
  <body>
    {showTopo && <TopoCanvas />}
    <header class="site-header">
      <div class="path">
        <a href="/" class="brand">made by sam</a>
        {breadcrumb.map((c, i) => (
          <>
            <span class="sep" aria-hidden="true">/</span>
            {c.href ? (
              <a href={c.href} class="crumb">{c.label}</a>
            ) : (
              <span class="crumb crumb--current" aria-current="page">{c.label}</span>
            )}
          </>
        ))}
      </div>
      <nav>
        <a href="/about" class="underline">about</a>
        <a href="/lab" class="underline">lab</a>
        <ThemeToggle />
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    z-index: 10;
    color: var(--color-fg);
    /* Soft halo in the bg color keeps text readable over topo lines */
    text-shadow:
      0 0 6px var(--color-bg),
      0 0 14px var(--color-bg);
  }

  .path {
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-width: 0; /* allow truncation on narrow viewports */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .brand {
    font-weight: 500;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .sep {
    opacity: 0.4;
    flex-shrink: 0;
  }
  .crumb {
    color: inherit;
    text-decoration: none;
    text-transform: lowercase;
    opacity: 0.65;
    transition: opacity var(--transition), color var(--transition);
  }
  .crumb:hover { opacity: 1; }
  .crumb--current {
    color: var(--color-accent);
    opacity: 1;
    cursor: default;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.95rem;
  }

  main {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  /* Cross-origin page fade. Internal Astro nav already animates via
     ClientRouter; this only kicks in for the inbound paint and for outbound
     clicks to sibling subdomains (e.g. dvd.madebysam.dev), so the jump
     across origins feels continuous instead of a hard cut. */
  body { animation: page-fade-in 0.4s ease-out; }
  body.is-leaving { transition: opacity 0.3s ease-out; opacity: 0; }
  @keyframes page-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Shared halo for readable text over the topo background */
  main :where(h1, h2, h3, p) {
    text-shadow:
      0 0 10px var(--color-bg),
      0 0 22px var(--color-bg);
  }
</style>
