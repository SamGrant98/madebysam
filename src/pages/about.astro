---
import Base from '../layouts/Base.astro';
---

<Base title="about — made by sam">
  <article class="about">
    <h1>About</h1>
    <p class="lede">
      I'm Sam — a creative technologist based in the UK. I build interactive installations,
      AI-driven experiences, and the occasional weird web toy.
    </p>

    <section>
      <h2>What I do</h2>
      <p>
        By day: design and engineer kiosk experiences, installations, and AI pipelines for
        live events. By night: whatever's in <a href="/lab" class="underline">/lab</a> this week.
      </p>
    </section>

    <section>
      <h2>Get in touch</h2>
      <ul class="links">
        <li><a href="mailto:samgrantarab@gmail.com" class="underline">samgrantarab@gmail.com</a></li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .about {
    max-width: 42rem;
    margin: 0 auto;
    padding: calc(var(--space-8) * 1.5) var(--space-4) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-1);
  }
  .lede {
    font-size: 1.15rem;
    color: var(--color-fg);
    opacity: 0.75;
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
</style>
