---
import Base from '../layouts/Base.astro';
---

<Base title="about — made by sam" breadcrumb={[{ label: 'about' }]}>
  <article class="about">
    <h1>About</h1>
    <p class="lede">
      I'm Sam, a creative technologist based in the UK with a background in game design and a career built across interactive experiences, immersive technology, and the web.
    </p>

    <section>
      <h2>What I do</h2>
      <p>
        I design and develop across a broad range of disciplines: websites, mobile apps, VR experiences, web AR, historic and cultural exhibitions, and interactive installations. My work spans concept and prototyping through to deployment.
      </p>
      <p>
        Currently part of the creative technology team at SeymourPowell, a design and innovation consultancy in London. The <a href="/lab" class="underline">/lab</a> is where I build independently, personal projects and experiments outside of client work.
      </p>
    </section>

    <section>
      <h2>Stack</h2>
      <div class="stack" aria-label="Stack">
        <span class="chip">JavaScript</span>
        <span class="chip">TypeScript</span>
        <span class="chip">Three.js</span>
        <span class="chip">Unity (C#)</span>
        <span class="chip">Meta Quest</span>
        <span class="chip">Web AR</span>
      </div>
    </section>

    <section>
      <h2>Get in touch</h2>
      <ul class="links">
        <li><a href="mailto:samgrantarab@gmail.com" class="underline">samgrantarab@gmail.com</a></li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .about {
    max-width: 42rem;
    margin: 0 auto;
    padding: calc(var(--space-8) * 1.5) var(--space-4) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-1);
  }
  .lede {
    font-size: 1.15rem;
    color: var(--color-fg);
    opacity: 0.75;
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    font-size: 0.75rem;
    padding: 4px 10px;
    border: 1px solid color-mix(in oklab, var(--color-accent) 40%, transparent);
    border-radius: 999px;
    color: var(--color-accent);
    opacity: 0.9;
  }
</style>
