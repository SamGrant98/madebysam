---
// Home: straight into the work.
//   hero      orange flood + Sam's dot portrait sitting across its bottom
//             edge (half on the orange, half on the page). Hovering pushes
//             the dots around; clicking goes to /about.
//   selected  the first four lab projects
//   instruments  the four categories and a way into the lab
// Sections with data-path feed the header's path as you scroll.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FloodHero from '../components/FloodHero.astro';
import DotPortrait from '../components/DotPortrait.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Glyph from '../components/Glyph.astro';
import { CATEGORIES, CATEGORY_KEYS } from '../lib/categories';

// Same ordering as the lab (frontmatter `order`), first four.
const selected = (await getCollection('lab'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base title="made by sam">
  <div class="hero">
    <FloodHero tone="brand" marks="dots" class="hero__flood">
      <span slot="eyebrow" class="home-eyebrow">Sam Grant</span>
      <h1 class="display home-h1">
        I enjoy <span class="accent">making</span> things. Hope you enjoy them too.
      </h1>
    </FloodHero>
    <div class="hero__portrait">
      <DotPortrait href="/about" controls={false} split />
    </div>
  </div>

  <section class="selected" data-path="selected">
    <div class="section-head">
      <h2 class="display section-h2">Selected</h2>
      <a href="/lab" class="label underline">all in the lab</a>
    </div>
    <div class="selected__grid">
      {selected.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </section>

  <section class="instruments" data-path="instruments">
    <p class="display instruments__line">Instruments for sound, movement, space and play.</p>
    <div class="instruments__side">
      <ul class="chips" aria-label="Categories">
        {CATEGORY_KEYS.map((key) => (
          <li class="chip" style={`color: ${CATEGORIES[key].textColor}`}>
            <Glyph kind={CATEGORIES[key].glyph} size={12} />
            {key}
          </li>
        ))}
      </ul>
      <a href="/lab" class="button">Open the lab</a>
    </div>
  </section>

  <SiteFooter />
</Base>

<style>
  /* Every block pads in whole cells and starts at the page margin, so all
     edges land on dot columns (press G in dev to check). */

  .home-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .home-h1 {
    margin: 0;
    font-size: clamp(2.75rem, 8vw, 7rem);
    max-width: 13ch;
  }

  /* ---- Hero + portrait ----
     --portrait is the portrait's width. 70% of it sits on the flood and
     30% hangs below, onto the page. */
  .hero {
    --portrait: min(calc(100vw - var(--page-margin) * 2), calc(var(--grid) * 14));
  }
  .hero__portrait {
    position: relative;
    z-index: 2; /* above the flood */
    width: var(--portrait);
    margin: calc(var(--portrait) * -0.7) auto 0;
  }
  /* Phones and tablets: the portrait is centred under the heading, so the
     flood gets extra room at the bottom for it. */
  .hero :global(.hero__flood .flood__content) {
    padding-bottom: calc(var(--grid) * 3 + var(--portrait) * 0.7);
  }
  /* Desktop: portrait on the right, heading keeps clear of it. */
  @media (min-width: 1025px) {
    .hero {
      /* 40% of the screen width, from 16 cells (384px) up to 44 (1056px) */
      --portrait: clamp(calc(var(--grid) * 16), 40vw, calc(var(--grid) * 44));
    }
    /* A taller flood on big screens, so the bigger head still fits on it. */
    .hero :global(.hero__flood) {
      min-height: min(82svh, 920px);
      min-height: round(down, min(82svh, 920px), var(--grid));
    }
    .hero__portrait {
      margin-right: var(--page-margin);
    }
    .hero :global(.hero__flood .flood__content) {
      padding-bottom: calc(var(--grid) * 3);
    }
    /* The heading scales with the screen so it stays three lines and
       keeps clear of the head on the right. */
    .home-h1 {
      font-size: clamp(2.75rem, 6vw, 7rem);
    }
  }

  .selected {
    padding: calc(var(--grid) * 2) var(--page-margin) calc(var(--grid) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--grid) * 2);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--grid);
  }
  .section-h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .selected__grid {
    display: grid;
    /* 19 cells wide minimum (456px), so two columns from tablet up. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 456px), 1fr));
    gap: calc(var(--grid) * 3) calc(var(--grid) * 2);
  }

  .instruments {
    padding: calc(var(--grid) * 3) var(--page-margin);
    border-top: 1px solid color-mix(in oklab, var(--color-fg) 12%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--grid) * 2) calc(var(--grid) * 4);
    align-items: flex-end;
  }
  .instruments__line {
    flex: 1 1 28rem;
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 4rem);
    max-width: 18ch;
  }
  .instruments__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--grid);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--grid) / 3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.9em;
    border: 1px solid color-mix(in oklab, var(--color-fg) 14%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
