---
import Base from '../layouts/Base.astro';
---

<Base title="made by sam">
  <section class="hero">
    <p class="eyebrow">Sam Grant</p>
    <h1>I make things that are a little bit weird, and a lot bit fun.</h1>
    <p class="lede">
      Creative technologist exploring the edges of AI, interaction, and physical computing.
      Currently cooking up experiments in the <a href="/lab" class="underline">lab</a>.
    </p>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    max-width: 56rem;
    padding: var(--space-8) var(--space-4);
    margin: 0 auto;
    gap: var(--space-3);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    max-width: 22ch;
    color: var(--color-fg);
  }
  .lede {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    max-width: 42ch;
    color: var(--color-fg);
    opacity: 0.75;
    margin-top: var(--space-2);
  }
</style>
