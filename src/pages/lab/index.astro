---
import Base from '../../layouts/Base.astro';

// Lab nodes — each has an anchor (mapPosition) and gentle drift parameters.
// The drift is computed in JS each frame; SVG edges follow the moving anchors.

type Category = 'three-d' | 'generative' | 'data' | 'audio' | 'tools';
type Status = 'live' | 'sketching' | 'parked';

interface Experiment {
  id: string;
  title: string;
  slug?: string;
  href?: string;
  category: Category;
  status: Status;
  note?: string;
  mapPosition: { x: number; y: number };
  drift: { ampX: number; ampY: number; freqX: number; freqY: number; phaseX: number; phaseY: number };
}

const experiments: Experiment[] = [
  {
    id: 'dvd-shelf',
    title: 'DVD Shelf',
    href: 'https://dvd.madebysam.dev',
    category: 'three-d',
    status: 'live',
    note: 'A 3D shelf for your physical media. Drop in a CSV, browse in space.',
    mapPosition: { x: 0.74, y: 0.36 },
    drift: { ampX: 1.4, ampY: 1.0, freqX: 0.55, freqY: 0.7, phaseX: 0.0, phaseY: 1.4 },
  },
  {
    id: 'topo-playground',
    title: 'Topo Playground',
    category: 'generative',
    status: 'sketching',
    note: 'Same shader as this background, with knobs.',
    mapPosition: { x: 0.24, y: 0.46 },
    drift: { ampX: 1.2, ampY: 1.3, freqX: 0.42, freqY: 0.58, phaseX: 1.1, phaseY: 0.3 },
  },
  {
    id: 'palette-generator',
    title: 'Palette Generator',
    category: 'tools',
    status: 'sketching',
    note: 'Throw a photo at it, get a colour system out.',
    mapPosition: { x: 0.78, y: 0.7 },
    drift: { ampX: 1.5, ampY: 0.9, freqX: 0.65, freqY: 0.48, phaseX: 2.2, phaseY: 1.8 },
  },
  {
    id: 'audio-reactive',
    title: 'Audio Reactive',
    category: 'audio',
    status: 'sketching',
    note: 'Mic input drives a shader — volume, frequency, beat.',
    mapPosition: { x: 0.36, y: 0.78 },
    drift: { ampX: 1.1, ampY: 1.4, freqX: 0.5, freqY: 0.36, phaseX: 0.7, phaseY: 2.5 },
  },
];

const connections: [string, string][] = [
  ['dvd-shelf', 'topo-playground'],
  ['dvd-shelf', 'palette-generator'],
  ['topo-playground', 'audio-reactive'],
  ['palette-generator', 'audio-reactive'],
  ['topo-playground', 'palette-generator'],
];

const categoryLabels: Record<Category, string> = {
  'three-d': '3D',
  'generative': 'Generative',
  'data': 'Data',
  'audio': 'Audio',
  'tools': 'Tools',
};

// Pre-compute initial edge coords (in viewBox 0..100 units = percent of viewport)
// so the first paint shows them in the right place; JS will animate the drift.
const edges = connections.map(([aId, bId], i) => {
  const a = experiments.find((e) => e.id === aId)!;
  const b = experiments.find((e) => e.id === bId)!;
  return {
    a: aId,
    b: bId,
    i,
    x1: a.mapPosition.x * 100,
    y1: a.mapPosition.y * 100,
    x2: b.mapPosition.x * 100,
    y2: b.mapPosition.y * 100,
  };
});

// Pass node/edge data to the floating-animation script
const driftData = {
  nodes: experiments.map((e) => ({
    id: e.id,
    x: e.mapPosition.x * 100,
    y: e.mapPosition.y * 100,
    ...e.drift,
  })),
  edges: connections.map(([a, b]) => ({ a, b })),
};
---

<Base title="lab — made by sam">
  <section class="lab-intro">
    <h1>Lab</h1>
    <p>A place to play. Experiments from the Obsidian vault, in public.</p>
  </section>

  <svg class="lab-edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {edges.map((e) => (
      <line
        class="edge"
        data-edge-a={e.a}
        data-edge-b={e.b}
        style={`--edge-i: ${e.i}`}
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        vector-effect="non-scaling-stroke"
      />
    ))}
  </svg>

  <div class="lab-map" aria-label="Experiments map">
    {experiments.map((exp, idx) => {
      const isLive = exp.status === 'live';
      const href = exp.href ?? (exp.slug ? `/lab/${exp.slug}` : undefined);
      const inner = (
        <>
          <span class="node__dot" aria-hidden="true" />
          <div class="node__label">
            <span class="node__title">{exp.title}</span>
            <span class="node__meta">
              <span>{categoryLabels[exp.category]}</span>
              {!isLive && <span class="node__status">{exp.status}</span>}
            </span>
            {exp.note && <span class="node__note">{exp.note}</span>}
          </div>
        </>
      );
      const cls = `node node--${exp.status}`;
      // Anchor position via CSS custom props — JS drift loop will update these
      const style = `--node-x: ${exp.mapPosition.x * 100}%; --node-y: ${exp.mapPosition.y * 100}%; --node-i: ${idx};`;
      return isLive && href ? (
        <a class={cls} data-node-id={exp.id} style={style} href={href}>{inner}</a>
      ) : (
        <div class={cls} data-node-id={exp.id} style={style} aria-disabled="true">{inner}</div>
      );
    })}
  </div>
</Base>

<script define:vars={{ driftData }}>
  // ---- Morph: topo → grid on enter ----
  function applyMorph() {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path !== '/lab') return;
    if (!window.__topo) return;
    window.__topo.setMorph(1, 1000);
  }
  document.addEventListener('astro:page-load', applyMorph);
  applyMorph();

  // ---- Floating network animation ----
  // Each node drifts on independent sine waves; SVG edges read the drifted
  // positions every frame so the lines stay attached to the moving dots.
  let rafId = 0;
  let cancelled = false;

  function startDrift() {
    const nodes = driftData.nodes.map((n) => ({
      ...n,
      el: document.querySelector(`[data-node-id="${n.id}"]`),
      cx: n.x,
      cy: n.y,
    }));
    if (nodes.some((n) => !n.el)) return; // page already swapped
    const nodeById = Object.fromEntries(nodes.map((n) => [n.id, n]));

    const edgeEls = Array.from(document.querySelectorAll('line.edge')).map((line) => ({
      line,
      a: nodeById[line.getAttribute('data-edge-a')],
      b: nodeById[line.getAttribute('data-edge-b')],
    })).filter((e) => e.a && e.b);

    const t0 = performance.now();

    function tick() {
      if (cancelled) return;
      const t = (performance.now() - t0) / 1000;
      for (const n of nodes) {
        n.cx = n.x + n.ampX * Math.sin(t * n.freqX + n.phaseX);
        n.cy = n.y + n.ampY * Math.sin(t * n.freqY + n.phaseY);
        n.el.style.setProperty('--node-x', n.cx + '%');
        n.el.style.setProperty('--node-y', n.cy + '%');
      }
      for (const e of edgeEls) {
        e.line.setAttribute('x1', e.a.cx);
        e.line.setAttribute('y1', e.a.cy);
        e.line.setAttribute('x2', e.b.cx);
        e.line.setAttribute('y2', e.b.cy);
      }
      rafId = requestAnimationFrame(tick);
    }
    tick();
  }

  function stopDrift() {
    cancelled = true;
    if (rafId) cancelAnimationFrame(rafId);
  }

  // Boot drift on enter, halt it when leaving the page
  function boot() {
    cancelled = false;
    startDrift();
  }
  document.addEventListener('astro:page-load', () => {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path === '/lab') boot();
    else stopDrift();
  });
  document.addEventListener('astro:before-preparation', stopDrift);
  boot();
</script>

<style>
  .lab-intro {
    position: fixed;
    top: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    animation: lab-intro-in 0.6s ease-out forwards;
    animation-delay: 0.55s;
  }
  @keyframes lab-intro-in {
    from { opacity: 0; transform: translate(-50%, -8px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }
  .lab-intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-1);
  }
  .lab-intro p {
    color: var(--color-fg);
    opacity: 0.7;
    font-size: 0.95rem;
  }

  /* SVG layer for the network edges. viewBox 0..100 with non-scaling-stroke
     lets us treat coords as percent-of-viewport. */
  .lab-edges {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }
  .edge {
    stroke: var(--color-fg);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-opacity: 0;
    animation: edge-in 0.55s ease-out forwards;
    animation-delay: calc(0.4s + var(--edge-i) * 0.08s);
  }
  @keyframes edge-in {
    from { stroke-opacity: 0; }
    to   { stroke-opacity: 0.35; }
  }

  .lab-map {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* Nodes positioned via CSS custom props that JS updates each frame for
     the drift effect. The translate(-50%,-50%) centres the dot on the coord. */
  .node {
    position: absolute;
    left: var(--node-x, 50%);
    top: var(--node-y, 50%);
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
    opacity: 0;
    animation: node-in 0.55s ease-out forwards;
    animation-delay: calc(0.7s + var(--node-i) * 0.08s);
  }
  .node[aria-disabled='true'] {
    cursor: default;
    animation-name: node-in-dim;
  }
  @keyframes node-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes node-in-dim {
    from { opacity: 0; }
    to   { opacity: 0.6; }
  }

  /* Exit fade — TopoCanvas adds body.lab-leaving before the swap so the
     DOM has time to fade while the topo morphs back. */
  :global(body.lab-leaving) .edge,
  :global(body.lab-leaving) .node,
  :global(body.lab-leaving) .lab-intro {
    animation: none;
    transition: opacity 0.35s ease-out;
    opacity: 0;
  }
  :global(body.lab-leaving) .edge {
    transition: stroke-opacity 0.35s ease-out;
    stroke-opacity: 0;
  }

  .node__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-fg);
    box-shadow:
      0 0 0 5px var(--color-bg),
      0 0 18px var(--color-bg);
    transition: transform var(--transition), background var(--transition);
  }
  .node:hover .node__dot {
    transform: scale(1.4);
    background: var(--color-accent);
  }
  .node[aria-disabled='true']:hover .node__dot {
    transform: none;
    background: var(--color-fg);
  }

  .node__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    max-width: 14rem;
    text-shadow:
      0 0 8px var(--color-bg),
      0 0 16px var(--color-bg),
      0 0 24px var(--color-bg);
  }
  .node__title {
    font-size: 1.05rem;
    font-weight: 500;
    transition: color var(--transition);
  }
  .node:hover .node__title { color: var(--color-accent); }
  .node[aria-disabled='true']:hover .node__title { color: inherit; }

  .node__meta {
    display: flex;
    gap: 8px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }
  .node__status { color: var(--color-accent); opacity: 0.9; }

  .node__note {
    font-size: 0.8rem;
    color: var(--color-fg);
    opacity: 0.7;
    max-width: 12rem;
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .lab-intro { top: calc(var(--space-8) - 1rem); }
    .node__label { max-width: 9rem; }
    .node__title { font-size: 0.95rem; }
    .node__note { font-size: 0.75rem; max-width: 9rem; }
  }
</style>
