---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Pull lab entries from the content collection. Each entry's frontmatter
// supplies title, blurb, status, mapPosition, drift — the same data that
// used to be a hardcoded array. Single source of truth shared with the
// detail page at /lab/[slug].
const labEntries = (await getCollection('lab')).sort(
  (a, b) => a.data.order - b.data.order,
);

const categoryLabels = {
  'three-d': '3D',
  'generative': 'Generative',
  'data': 'Data',
  'audio': 'Audio',
  'tools': 'Tools',
} as const;

// Pre-compute initial edge coords (in viewBox 0..100 units = percent of viewport).
// Connections are still defined here since they aren't a per-demo property.
const connections: [string, string][] = [
  ['dvd-shelf', 'topo-playground'],
  ['dvd-shelf', 'palette-generator'],
  ['topo-playground', 'audio-reactive'],
  ['palette-generator', 'audio-reactive'],
  ['topo-playground', 'palette-generator'],
];

const entryById = Object.fromEntries(labEntries.map((e) => [e.id, e]));
const edges = connections.map(([aId, bId], i) => {
  const a = entryById[aId];
  const b = entryById[bId];
  return {
    a: aId,
    b: bId,
    i,
    x1: a.data.mapPosition.x * 100,
    y1: a.data.mapPosition.y * 100,
    x2: b.data.mapPosition.x * 100,
    y2: b.data.mapPosition.y * 100,
  };
});

const driftData = {
  nodes: labEntries.map((e) => ({
    id: e.id,
    x: e.data.mapPosition.x * 100,
    y: e.data.mapPosition.y * 100,
    ...e.data.drift,
  })),
  edges: connections.map(([a, b]) => ({ a, b })),
};
---

<Base title="lab — made by sam" breadcrumb={[{ label: 'lab' }]}>
  <section class="lab-intro">
    <h1>Lab</h1>
    <p>A place to play. Experiments from the Obsidian vault, in public.</p>
  </section>

  <svg class="lab-edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {edges.map((e) => (
      <line
        class="edge"
        data-edge-a={e.a}
        data-edge-b={e.b}
        style={`--edge-i: ${e.i}`}
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        vector-effect="non-scaling-stroke"
      />
    ))}
  </svg>

  <div class="lab-map" aria-label="Experiments map">
    {labEntries.map((entry, idx) => {
      const { data } = entry;
      const cls = `node node--${data.status}`;
      const style = `--node-x: ${data.mapPosition.x * 100}%; --node-y: ${data.mapPosition.y * 100}%; --node-i: ${idx};`;
      return (
        <a class={cls} data-node-id={entry.id} style={style} href={`/lab/${entry.id}`}>
          <span class="node__dot" aria-hidden="true" />
          <div class="node__label">
            <span class="node__title">{data.title}</span>
            <span class="node__meta">
              <span>{categoryLabels[data.category]}</span>
              {data.status !== 'live' && <span class="node__status">{data.status}</span>}
            </span>
          </div>
        </a>
      );
    })}
  </div>
</Base>

<script define:vars={{ driftData }}>
  // ---- Morph: topo → grid on enter ----
  function applyMorph() {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path !== '/lab') return;
    if (!window.__topo) return;
    window.__topo.setMorph(1, 1000);
  }
  document.addEventListener('astro:page-load', applyMorph);
  applyMorph();

  // ---- Floating network animation ----
  let rafId = 0;
  let cancelled = false;

  function startDrift() {
    const nodes = driftData.nodes.map((n) => ({
      ...n,
      el: document.querySelector(`[data-node-id="${n.id}"]`),
      cx: n.x,
      cy: n.y,
    }));
    if (nodes.some((n) => !n.el)) return;
    const nodeById = Object.fromEntries(nodes.map((n) => [n.id, n]));

    const edgeEls = Array.from(document.querySelectorAll('line.edge')).map((line) => ({
      line,
      a: nodeById[line.getAttribute('data-edge-a')],
      b: nodeById[line.getAttribute('data-edge-b')],
    })).filter((e) => e.a && e.b);

    const t0 = performance.now();
    function tick() {
      if (cancelled) return;
      const t = (performance.now() - t0) / 1000;
      for (const n of nodes) {
        n.cx = n.x + n.ampX * Math.sin(t * n.freqX + n.phaseX);
        n.cy = n.y + n.ampY * Math.sin(t * n.freqY + n.phaseY);
        n.el.style.setProperty('--node-x', n.cx + '%');
        n.el.style.setProperty('--node-y', n.cy + '%');
      }
      for (const e of edgeEls) {
        e.line.setAttribute('x1', e.a.cx);
        e.line.setAttribute('y1', e.a.cy);
        e.line.setAttribute('x2', e.b.cx);
        e.line.setAttribute('y2', e.b.cy);
      }
      rafId = requestAnimationFrame(tick);
    }
    tick();
  }

  function stopDrift() {
    cancelled = true;
    if (rafId) cancelAnimationFrame(rafId);
  }

  function boot() {
    cancelled = false;
    startDrift();
  }
  document.addEventListener('astro:page-load', () => {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path === '/lab') boot();
    else stopDrift();
  });
  document.addEventListener('astro:before-preparation', stopDrift);
  boot();
</script>

<style>
  .lab-intro {
    position: fixed;
    top: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    animation: lab-intro-in 0.6s ease-out forwards;
    animation-delay: 0.55s;
  }
  @keyframes lab-intro-in {
    from { opacity: 0; transform: translate(-50%, -8px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }
  .lab-intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-1);
  }
  .lab-intro p {
    color: var(--color-fg);
    opacity: 0.7;
    font-size: 0.95rem;
  }

  .lab-edges {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }
  .edge {
    stroke: var(--color-fg);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-opacity: 0;
    animation: edge-in 0.55s ease-out forwards;
    animation-delay: calc(0.4s + var(--edge-i) * 0.08s);
  }
  @keyframes edge-in {
    from { stroke-opacity: 0; }
    to   { stroke-opacity: 0.35; }
  }

  .lab-map {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* Dot is the first child (14px tall); translate so ITS centre lands on
     the anchor coords so SVG edges connect dot-to-dot. */
  .node {
    position: absolute;
    left: var(--node-x, 50%);
    top: var(--node-y, 50%);
    transform: translate(-50%, -7px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
    opacity: 0;
    animation: node-in 0.55s ease-out forwards;
    animation-delay: calc(0.7s + var(--node-i) * 0.08s);
  }
  .node--sketching,
  .node--parked { animation-name: node-in-dim; }
  @keyframes node-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes node-in-dim {
    from { opacity: 0; }
    to   { opacity: 0.65; }
  }

  :global(body.lab-leaving) .edge,
  :global(body.lab-leaving) .node,
  :global(body.lab-leaving) .lab-intro {
    animation: none;
    transition: opacity 0.35s ease-out;
    opacity: 0;
  }
  :global(body.lab-leaving) .edge {
    transition: stroke-opacity 0.35s ease-out;
    stroke-opacity: 0;
  }

  .node__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-fg);
    box-shadow:
      0 0 0 5px var(--color-bg),
      0 0 18px var(--color-bg);
    transition: transform var(--transition), background var(--transition), box-shadow var(--transition);
  }
  /* Live demos get the accent — visually distinguishes "shipped + clickable
     to live" from "still cooking" without needing an extra label. */
  .node--live .node__dot {
    background: var(--color-accent);
    box-shadow:
      0 0 0 5px var(--color-bg),
      0 0 18px var(--color-bg),
      0 0 22px color-mix(in oklab, var(--color-accent) 35%, transparent);
  }
  .node:hover .node__dot {
    transform: scale(1.4);
  }
  .node--sketching:hover .node__dot,
  .node--parked:hover .node__dot {
    background: var(--color-accent);
  }

  .node__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    max-width: 14rem;
    text-shadow:
      0 0 8px var(--color-bg),
      0 0 16px var(--color-bg),
      0 0 24px var(--color-bg);
  }
  .node__title {
    font-size: 1.05rem;
    font-weight: 500;
    transition: color var(--transition);
  }
  .node:hover .node__title { color: var(--color-accent); }

  .node__meta {
    display: flex;
    gap: 8px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }
  .node__status { color: var(--color-accent); opacity: 0.9; }

  .node__note {
    font-size: 0.8rem;
    color: var(--color-fg);
    opacity: 0.7;
    max-width: 12rem;
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .lab-intro { top: calc(var(--space-8) - 1rem); }
    .node__label { max-width: 9rem; }
    .node__title { font-size: 0.95rem; }
    .node__note { font-size: 0.75rem; max-width: 9rem; }
  }
</style>
