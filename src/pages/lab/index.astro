---
// The lab: every project, as a floating map or a list.
//
// Map: each project is a node (its category glyph in a 44px circle) placed
// from its `mapPosition`, snapped to the page's dot grid, then drifting a
// little around that dot. Lines join related projects. On touch screens the
// first tap opens a small card with an Open button; on desktop the node is
// just a link. List: the same ProjectCards as the home page.
//
// No flood here (BRAND.md: index pages never flood).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { CATEGORIES } from '../../lib/categories';

const entries = (await getCollection('lab')).sort((a, b) => a.data.order - b.data.order);

// Which projects are joined by a line. Not a per-project property, so it
// lives here.
const connections: [string, string][] = [
  ['dvd-shelf', 'topo-playground'],
  ['dvd-shelf', 'palette-generator'],
  ['topo-playground', 'audio-reactive'],
  ['palette-generator', 'audio-reactive'],
  ['topo-playground', 'palette-generator'],
];
const byId = Object.fromEntries(entries.map((e) => [e.id, e]));
const edges = connections.filter(([a, b]) => byId[a] && byId[b]);
const pct = (v: number) => `${(v * 100).toFixed(2)}%`;
---

<Base title="lab / made by sam" breadcrumb={[{ label: 'lab' }]} showTopo={false}>
  <div class="lab" data-lab data-view="map">
    <section class="intro">
      <h1 class="display intro__title">Lab</h1>
      <p class="intro__lede">A place to play. Experiments from the Obsidian vault, in public.</p>
      <div class="intro__controls">
        <div class="toggle" role="group" aria-label="View">
          <button type="button" class="toggle__btn label" data-view-btn="map" aria-pressed="true">map</button>
          <button type="button" class="toggle__btn label" data-view-btn="list" aria-pressed="false">list</button>
        </div>
        <span class="label intro__count">{entries.length} projects</span>
      </div>
    </section>

    <section class="map" data-map aria-label="Lab map">
      <svg class="map__edges" aria-hidden="true">
        {edges.map(([a, b]) => (
          <line
            data-edge
            data-a={a}
            data-b={b}
            x1={pct(byId[a].data.mapPosition.x)}
            y1={pct(byId[a].data.mapPosition.y)}
            x2={pct(byId[b].data.mapPosition.x)}
            y2={pct(byId[b].data.mapPosition.y)}
          />
        ))}
      </svg>

      {entries.map((entry) => {
        const d = entry.data;
        const cat = CATEGORIES[d.category];
        return (
          <a
            href={`/lab/${entry.id}`}
            class:list={['node', `node--${d.status}`]}
            data-node={entry.id}
            data-x={d.mapPosition.x}
            data-y={d.mapPosition.y}
            data-drift={JSON.stringify(d.drift)}
            style={`--x: ${pct(d.mapPosition.x)}; --y: ${pct(d.mapPosition.y)}; --cat: ${cat.color}; --cat-text: ${cat.textColor}`}
            aria-label={`${d.title}, ${d.category}, ${d.status}`}
          >
            <span class="node__mark"><Glyph kind={cat.glyph} size={20} /></span>
            <span class="node__label" aria-hidden="true">
              <span class="node__title">{d.title}</span>
              {d.status !== 'live' && <span class="node__status label">{d.status}</span>}
            </span>
          </a>
        );
      })}

      {/* One card per project, hidden until its node is tapped (touch only). */}
      {entries.map((entry) => {
        const d = entry.data;
        const cat = CATEGORIES[d.category];
        return (
          <div
            class="card"
            data-card-for={entry.id}
            style={`--cat-text: ${cat.textColor}`}
            hidden
          >
            <span class="card__meta label">
              <Glyph kind={cat.glyph} size={12} /> {d.category} · {d.status}
            </span>
            <strong class="card__title">{d.title}</strong>
            <span class="card__blurb">{d.blurb}</span>
            <a class="button card__open" href={`/lab/${entry.id}`}>Open</a>
          </div>
        );
      })}
    </section>

    <section class="list" aria-label="All projects">
      {entries.map((entry) => <ProjectCard entry={entry} />)}
    </section>
  </div>

  <SiteFooter />
</Base>

<script>
  // Bundled script: runs once, then re-inits on every visit via
  // astro:page-load, and tears down on astro:before-swap (same pattern as
  // SiteHeader).
  const GRID = 24; // keep in step with --grid
  const DRIFT_PX = 8; // drift amplitude per unit of `amp` in the frontmatter

  type Drift = { ampX: number; ampY: number; freqX: number; freqY: number; phaseX: number; phaseY: number };
  type Node = { el: HTMLElement; id: string; x: number; y: number; d: Drift; bx: number; by: number; cx: number; cy: number };

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;
    const root = document.querySelector<HTMLElement>('[data-lab]');
    const map = root?.querySelector<HTMLElement>('[data-map]');
    if (!root || !map) return;

    const ac = new AbortController();
    const { signal } = ac;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const touch = matchMedia('(hover: none)').matches;

    // ---- Map / list toggle (remembered per browser) ----
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
    function setView(v: string) {
      root!.dataset.view = v;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === v)));
      try { localStorage.setItem('lab-view', v); } catch {}
      if (v === 'map') layout();
    }
    buttons.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn!), { signal }));

    // ---- Nodes and edges ----
    const nodes: Node[] = [...map.querySelectorAll<HTMLElement>('[data-node]')].map((el) => ({
      el,
      id: el.dataset.node!,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      d: JSON.parse(el.dataset.drift!),
      bx: 0, by: 0, cx: 0, cy: 0,
    }));
    const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
    const edges = [...map.querySelectorAll<SVGLineElement>('[data-edge]')]
      .map((line) => ({ line, a: byId[line.dataset.a!], b: byId[line.dataset.b!] }))
      .filter((e) => e.a && e.b);

    // From here on, JS places the nodes in pixels (CSS % positions are only
    // the no-JS fallback).
    map.classList.add('is-live');

    // Base position, in three steps:
    //   1. Stretch: mapPosition values only matter relative to each other,
    //      so the group is stretched to fill the map (whatever its shape).
    //   2. Pad: keep room at the edges for the labels under each node.
    //   3. Snap to the nearest dot on the PAGE grid (dots sit on multiples
    //      of 24 from the page's top-left).
    const range = (vals: number[]) => {
      const lo = Math.min(...vals), hi = Math.max(...vals);
      return { lo, span: hi - lo || 1 };
    };
    const rx = range(nodes.map((n) => n.x));
    const ry = range(nodes.map((n) => n.y));

    let w = 0, h = 0;
    function layout() {
      const r = map!.getBoundingClientRect();
      if (!r.width) return;
      w = r.width; h = r.height;
      const left = r.left + scrollX;
      const top = r.top + scrollY;
      const padX = Math.max(GRID * 4, w * 0.12); // half a label each side
      const padTop = GRID * 3;
      const padBottom = GRID * 5; // the label hangs below the node
      const snap = (v: number) => Math.round(v / GRID) * GRID;
      for (const n of nodes) {
        const fx = (n.x - rx.lo) / rx.span;
        const fy = (n.y - ry.lo) / ry.span;
        n.bx = snap(left + padX + fx * (w - padX * 2)) - left;
        n.by = snap(top + padTop + fy * (h - padTop - padBottom)) - top;
      }
      draw(performance.now());
    }

    // ---- Tap card (touch screens) ----
    const cards = Object.fromEntries(
      [...map.querySelectorAll<HTMLElement>('[data-card-for]')].map((c) => [c.dataset.cardFor!, c]),
    );
    let selected: Node | null = null;
    function select(n: Node | null) {
      if (selected) {
        cards[selected.id].hidden = true;
        selected.el.classList.remove('is-selected');
      }
      selected = n;
      if (n) {
        cards[n.id].hidden = false;
        n.el.classList.add('is-selected');
        placeCard();
      }
    }
    function placeCard() {
      if (!selected) return;
      const card = cards[selected.id];
      const cw = card.offsetWidth, ch = card.offsetHeight;
      const x = Math.min(Math.max(selected.cx - cw / 2, GRID), w - cw - GRID);
      // Below the node if it fits, otherwise above.
      const below = selected.cy + GRID * 1.5;
      const y = below + ch < h ? below : selected.cy - GRID * 1.5 - ch;
      card.style.transform = `translate(${x}px, ${y}px)`;
    }

    map.addEventListener('click', (e) => {
      const target = e.target as Element;
      const nodeEl = target.closest<HTMLElement>('[data-node]');
      if (nodeEl && touch) {
        const n = byId[nodeEl.dataset.node!];
        if (selected !== n) {
          e.preventDefault(); // first tap opens the card, the card's button navigates
          select(n);
        }
        return;
      }
      if (!target.closest('[data-card-for]')) select(null);
    }, { signal });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') select(null); }, { signal });

    // ---- Drift ----
    function draw(now: number) {
      const t = now / 1000;
      const amp = reduceMotion ? 0 : DRIFT_PX;
      for (const n of nodes) {
        n.cx = n.bx + amp * n.d.ampX * Math.sin(t * n.d.freqX + n.d.phaseX);
        n.cy = n.by + amp * n.d.ampY * Math.sin(t * n.d.freqY + n.d.phaseY);
        n.el.style.transform = `translate(${n.cx}px, ${n.cy}px)`;
      }
      for (const e of edges) {
        e.line.setAttribute('x1', String(e.a.cx));
        e.line.setAttribute('y1', String(e.a.cy));
        e.line.setAttribute('x2', String(e.b.cx));
        e.line.setAttribute('y2', String(e.b.cy));
      }
      placeCard();
    }

    let raf = 0;
    function loop(now: number) {
      if (root!.dataset.view === 'map') draw(now);
      raf = requestAnimationFrame(loop);
    }

    let saved = 'map';
    try { saved = localStorage.getItem('lab-view') ?? 'map'; } catch {}
    setView(saved === 'list' ? 'list' : 'map');

    const ro = new ResizeObserver(layout);
    ro.observe(map);
    document.fonts?.ready.then(layout);
    if (!reduceMotion) raf = requestAnimationFrame(loop);

    cleanup = () => {
      ac.abort();
      ro.disconnect();
      cancelAnimationFrame(raf);
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---- Intro ---- */
  .intro {
    padding: calc(var(--header-h) + var(--grid) * 2) var(--page-margin) calc(var(--grid) * 2);
    display: flex;
    flex-direction: column;
    gap: var(--grid);
  }
  .intro__title {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.92;
  }
  .intro__lede {
    margin: 0;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    max-width: 36ch;
    opacity: 0.75;
  }
  .intro__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--grid);
  }
  .intro__count {
    opacity: 0.55;
  }

  .toggle {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid color-mix(in oklab, var(--color-fg) 14%, transparent);
    border-radius: 999px;
    background: var(--color-bg);
  }
  .toggle__btn {
    min-height: 40px;
    padding: 0 calc(var(--grid) * 2 / 3);
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    opacity: 0.6;
    cursor: pointer;
  }
  .toggle__btn[aria-pressed='true'] {
    background: var(--color-fg);
    color: var(--color-bg);
    opacity: 1;
  }

  /* Only one view at a time. */
  .lab[data-view='map'] .list,
  .lab[data-view='list'] .map {
    display: none;
  }

  /* ---- Map ---- */
  .map {
    position: relative;
    overflow: hidden;
    border-top: 1px solid color-mix(in oklab, var(--color-fg) 12%, transparent);
    /* Whole cells tall, so the footer below starts on a grid line. */
    height: max(36rem, 72svh);
    height: round(down, max(36rem, 72svh), var(--grid));
  }
  @media (max-width: 640px) {
    /* Portrait: positions stretch down a taller map. */
    .map {
      height: 110svh;
      height: round(down, 110svh, var(--grid));
    }
  }

  .map__edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .map__edges line {
    stroke: var(--color-fg);
    stroke-opacity: 0.22;
    stroke-width: 1;
  }

  .node {
    position: absolute;
    /* No-JS fallback: percentage position. JS switches to pixels. */
    left: var(--x);
    top: var(--y);
    /* The 44px mark is centred on the point; the label hangs below it. */
    margin: -22px 0 0 -22px;
    color: inherit;
    text-decoration: none;
  }
  .map.is-live .node {
    left: 0;
    top: 0;
  }

  .node__mark {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--cat-text);
    background: var(--color-bg);
    /* thin ring, then a paper-coloured moat so lines stop short of it */
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--color-fg) 16%, transparent),
      0 0 0 6px var(--color-bg);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .node--live .node__mark {
    box-shadow:
      0 0 0 1.5px var(--orange),
      0 0 0 6px var(--color-bg),
      0 0 22px color-mix(in oklab, var(--orange) 35%, transparent);
  }
  .node--sketching .node__mark,
  .node--parked .node__mark {
    opacity: 0.8;
  }
  .node:hover .node__mark,
  .node:focus-visible .node__mark,
  .node.is-selected .node__mark {
    opacity: 1;
    transform: scale(1.08);
    box-shadow:
      0 0 0 1.5px var(--cat-text),
      0 0 0 6px var(--color-bg),
      0 0 24px color-mix(in oklab, var(--cat) 45%, transparent);
  }

  .node__label {
    position: absolute;
    top: calc(100% + var(--grid) / 2);
    left: 50%;
    translate: -50% 0;
    width: max-content;
    max-width: 12rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
    pointer-events: none;
  }
  .node__title {
    font-weight: 700;
    letter-spacing: -0.01em;
    /* a paper halo so the label reads over lines and dots */
    text-shadow: 0 0 6px var(--color-bg), 0 0 12px var(--color-bg);
  }
  .node:hover .node__title {
    color: var(--orange-text);
  }
  .node__status {
    opacity: 0.55;
  }
  .node.is-selected .node__label {
    visibility: hidden; /* the card replaces it */
  }

  .card {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: min(18rem, calc(100% - var(--grid) * 2));
    padding: calc(var(--grid) * 2 / 3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--grid) / 3);
    border: 1px solid color-mix(in oklab, var(--color-fg) 14%, transparent);
    border-radius: 6px;
    background: var(--color-bg);
    box-shadow: 0 12px 32px color-mix(in oklab, var(--ink) 25%, transparent);
  }
  .card[hidden] {
    display: none;
  }
  .card__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--cat-text);
  }
  .card__title {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .card__blurb {
    opacity: 0.7;
    font-size: 0.9375rem;
  }
  .card__open {
    margin-top: calc(var(--grid) / 3);
  }

  @media (max-width: 640px) {
    .node__status {
      display: none; /* titles only on phones; the card has the rest */
    }
    .node__title {
      font-size: 0.9375rem;
    }
  }

  /* ---- List ---- */
  .list {
    padding: calc(var(--grid) * 2) var(--page-margin) calc(var(--grid) * 4);
    border-top: 1px solid color-mix(in oklab, var(--color-fg) 12%, transparent);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 456px), 1fr));
    gap: calc(var(--grid) * 3) calc(var(--grid) * 2);
  }
</style>
