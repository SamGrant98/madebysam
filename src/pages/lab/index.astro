---
import Base from '../../layouts/Base.astro';

// Lab nodes. mapPosition.{x,y} are normalised viewport coords (0..1, y from
// the TOP). Connections define the edges the shader will draw as part of
// the topo→network morph.

type Category = 'three-d' | 'generative' | 'data' | 'audio' | 'tools';
type Status = 'live' | 'sketching' | 'parked';

interface Experiment {
  id: string;
  title: string;
  slug?: string;
  href?: string;
  category: Category;
  status: Status;
  note?: string;
  mapPosition: { x: number; y: number };
}

const experiments: Experiment[] = [
  {
    id: 'dvd-shelf',
    title: 'DVD Shelf',
    href: 'https://dvd.madebysam.dev',
    category: 'three-d',
    status: 'live',
    note: 'A 3D shelf for your physical media. Drop in a CSV, browse in space.',
    mapPosition: { x: 0.74, y: 0.36 },
  },
  {
    id: 'topo-playground',
    title: 'Topo Playground',
    category: 'generative',
    status: 'sketching',
    note: 'Same shader as this background, with knobs.',
    mapPosition: { x: 0.24, y: 0.46 },
  },
  {
    id: 'palette-generator',
    title: 'Palette Generator',
    category: 'tools',
    status: 'sketching',
    note: 'Throw a photo at it, get a colour system out.',
    mapPosition: { x: 0.78, y: 0.7 },
  },
  {
    id: 'audio-reactive',
    title: 'Audio Reactive',
    category: 'audio',
    status: 'sketching',
    note: 'Mic input drives a shader — volume, frequency, beat.',
    mapPosition: { x: 0.36, y: 0.78 },
  },
];

const connections: [string, string][] = [
  ['dvd-shelf', 'topo-playground'],
  ['dvd-shelf', 'palette-generator'],
  ['topo-playground', 'audio-reactive'],
  ['palette-generator', 'audio-reactive'],
  ['topo-playground', 'palette-generator'],
];

const categoryLabels: Record<Category, string> = {
  'three-d': '3D',
  'generative': 'Generative',
  'data': 'Data',
  'audio': 'Audio',
  'tools': 'Tools',
};

// Serialise topo network config for the in-page script.
//   peak  falloff 120 → tight ring nest under each dot
//   seg   falloff 28  → ridges wide enough to see mid-morph collapse to centreline
const topoData = {
  peaks: experiments.map((e) => ({
    x: e.mapPosition.x,
    y: e.mapPosition.y,
    falloff: 120,
    strength: 0.32,
  })),
  segments: connections.map(([aId, bId]) => {
    const a = experiments.find((e) => e.id === aId)!;
    const b = experiments.find((e) => e.id === bId)!;
    return {
      a: { x: a.mapPosition.x, y: a.mapPosition.y },
      b: { x: b.mapPosition.x, y: b.mapPosition.y },
      falloff: 28,
      strength: 0.7,
    };
  }),
};
---

<Base title="lab — made by sam">
  <section class="lab-intro">
    <h1>Lab</h1>
    <p>A place to play. Experiments from the Obsidian vault, in public.</p>
  </section>

  <div class="lab-map" aria-label="Experiments map">
    {experiments.map((exp, idx) => {
      const isLive = exp.status === 'live';
      const href = exp.href ?? (exp.slug ? `/lab/${exp.slug}` : undefined);
      const style = `left: ${exp.mapPosition.x * 100}%; top: ${exp.mapPosition.y * 100}%; --node-i: ${idx};`;
      const inner = (
        <>
          <span class="node__dot" aria-hidden="true" />
          <div class="node__label">
            <span class="node__title">{exp.title}</span>
            <span class="node__meta">
              <span>{categoryLabels[exp.category]}</span>
              {!isLive && <span class="node__status">{exp.status}</span>}
            </span>
            {exp.note && <span class="node__note">{exp.note}</span>}
          </div>
        </>
      );
      return isLive && href ? (
        <a class={`node node--${exp.status}`} style={style} href={href}>{inner}</a>
      ) : (
        <div class={`node node--${exp.status}`} style={style} aria-disabled="true">{inner}</div>
      );
    })}
  </div>
</Base>

<script define:vars={{ topoData }}>
  function applyMorph() {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path !== '/lab') return;
    if (!window.__topo) return;
    window.__topo.setMorphTargets(topoData);
    window.__topo.setMorph(1, 1200);
  }
  document.addEventListener('astro:page-load', applyMorph);
  applyMorph();
</script>

<style>
  .lab-intro {
    position: fixed;
    top: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 3;
    pointer-events: none;
    /* Fade with the morph — title appears as the network resolves */
    opacity: 0;
    animation: lab-intro-in 0.7s ease-out forwards;
    animation-delay: 0.55s;
  }
  @keyframes lab-intro-in {
    from { opacity: 0; transform: translate(-50%, -8px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }
  .lab-intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-1);
  }
  .lab-intro p {
    color: var(--color-fg);
    opacity: 0.7;
    font-size: 0.95rem;
  }

  .lab-map {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
    opacity: 0;
    /* Nodes land AFTER the shader morph has drawn the connecting lines.
       Stagger keeps the arrival feeling organic — the network "wires up",
       then the landmarks settle one by one. */
    animation: node-in 0.55s ease-out forwards;
    animation-delay: calc(0.85s + var(--node-i) * 0.08s);
  }
  .node[aria-disabled='true'] {
    cursor: default;
    animation-name: node-in-dim;
  }
  @keyframes node-in {
    from { opacity: 0; transform: translate(-50%, -45%); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
  }
  @keyframes node-in-dim {
    from { opacity: 0; transform: translate(-50%, -45%); }
    to   { opacity: 0.6; transform: translate(-50%, -50%); }
  }

  .node__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-fg);
    /* Halo so the dot stays distinct from the shader-drawn ring nest */
    box-shadow:
      0 0 0 5px var(--color-bg),
      0 0 18px var(--color-bg);
    transition: transform var(--transition), background var(--transition);
  }
  .node:hover .node__dot {
    transform: scale(1.4);
    background: var(--color-accent);
  }
  .node[aria-disabled='true']:hover .node__dot {
    transform: none;
    background: var(--color-fg);
  }

  .node__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    max-width: 14rem;
    text-shadow:
      0 0 8px var(--color-bg),
      0 0 16px var(--color-bg),
      0 0 24px var(--color-bg);
  }
  .node__title {
    font-size: 1.05rem;
    font-weight: 500;
    transition: color var(--transition);
  }
  .node:hover .node__title { color: var(--color-accent); }
  .node[aria-disabled='true']:hover .node__title { color: inherit; }

  .node__meta {
    display: flex;
    gap: 8px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }
  .node__status { color: var(--color-accent); opacity: 0.9; }

  .node__note {
    font-size: 0.8rem;
    color: var(--color-fg);
    opacity: 0.7;
    max-width: 12rem;
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .lab-intro { top: calc(var(--space-8) - 1rem); }
    .node__label { max-width: 9rem; }
    .node__title { font-size: 0.95rem; }
    .node__note { font-size: 0.75rem; max-width: 9rem; }
  }
</style>
